            name: Passive Status
          - entity: sensor.sofarsolar_sofar_passive_control_register_target
            secondary_info: last-changed
            name: Passive Control Register
        title: Inverter Status
        view_layout:
          position: sidebar
      - type: energy-date-selection
        view_layout:
          position: sidebar
      - type: energy-sources-table
        title: Energy Sources
        view_layout:
          position: sidebar
      - cards:
          - entities:
              - entity: sensor.total_daily_energy_metered
                index: 0
                name: Total
            hours_to_show: 8
            icon: mdi:server
            line_width: 3
            points_per_hour: 20
            type: custom:mini-graph-card
        title: Daily Energy
        type: custom:stack-in-card
        view_layout:
          position: sidebar
      - title: Monthly Energy
        cards:
          - entities:
              - entity: sensor.total_monthly_energy
            hours_to_show: 8
            icon: mdi:server
            line_width: 3
            points_per_hour: 30
            type: custom:mini-graph-card
        type: custom:stack-in-card
        view_layout:
          position: sidebar
      - type: energy-carbon-consumed-gauge
        view_layout:
          position: sidebar
      - chart_type: bar
        period: day
        type: statistics-graph
        entities:
          - entity: sensor.total_daily_energy_peak
            name: Grid Import Peak
          - entity: sensor.total_daily_energy_off_peak
            name: Grid Import OffPeak
          - sensor.sofarsolar_import_daily
          - sensor.sofarsolar_export_daily
          - sensor.grid_net_export_daily
        title: AC Grid Power
        stat_types:
          - change
        logarithmic_scale: false
        days_to_show: 5
        expand_legend: false
        energy_date_selection: false
